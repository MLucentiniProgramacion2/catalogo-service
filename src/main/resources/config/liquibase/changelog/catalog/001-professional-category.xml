<?xml version="1.0" encoding="utf-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <!--
        Copia local de las categorías profesionales de la cátedra (contrato §7 y §14.4).
        La clave primaria es el ID de la cátedra: no se genera. Las bajas son lógicas (enabled = false).
        Los textos van en "text" porque el contrato no fija largos. Los instantes, en "timestamp" sin zona y en UTC
        (hibernate.type.preferred_instant_jdbc_type: TIMESTAMP y hibernate.jdbc.time_zone: UTC).
    -->
    <changeSet id="catalog-001-professional-category" author="maximoLucentini">
        <createTable tableName="professional_category" remarks="Copia local de las categorías profesionales de la cátedra">
            <column name="id" type="bigint" remarks="ID de la cátedra">
                <constraints primaryKey="true" primaryKeyName="pk_professional_category" nullable="false"/>
            </column>
            <column name="name" type="text">
                <constraints nullable="false"/>
            </column>
            <column name="description" type="text"/>
            <column name="enabled" type="boolean" remarks="false = baja lógica">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="timestamp" remarks="Instante UTC informado por la cátedra">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="timestamp" remarks="Instante UTC informado por la cátedra">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>
</databaseChangeLog>
