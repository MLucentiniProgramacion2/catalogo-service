# Copiar a .env (ignorado por Git) y completar con valores reales:
#   cp .env.example .env
# Nunca commitear .env ni pegar sus valores en issues, PRs o logs.

# --- Base de datos propia del servicio (PostgreSQL) ---
CATALOGO_DB_NAME=catalogo
CATALOGO_DB_USER=catalogo_app
CATALOGO_DB_PASSWORD=cambiar_esto
# Puerto del host; usar otro distinto en el servicio de turnos.
CATALOGO_DB_PORT=5433
