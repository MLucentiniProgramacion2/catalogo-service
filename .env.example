# Copiar a .env (ignorado por Git) y completar con valores reales:
#   cp .env.example .env
# Nunca commitear .env ni pegar sus valores en issues, PRs o logs.

# --- Base de datos propia del servicio (PostgreSQL) ---
# Host de la base; por defecto localhost (la de docker compose up -d).
CATALOGO_DB_HOST=localhost
CATALOGO_DB_NAME=catalogo
CATALOGO_DB_USER=catalogo_app
CATALOGO_DB_PASSWORD=cambiar_esto
# Puerto del host; usar otro distinto en el servicio de turnos.
CATALOGO_DB_PORT=5433

# --- Clave de firma del JWT (HS512, ver docs/adr/0003-validacion-jwt.md) ---
# Generar con:  openssl rand -base64 64 | tr -d '\n'
# Usar EXACTAMENTE el mismo valor en turnos-service: turnos firma los tokens
# con esta clave y el catálogo los valida con ella.
# Si queda vacía o falta, la aplicación no arranca.
JWT_BASE64_SECRET=

# --- API REST de la cátedra (ver docs/adr/0004-cliente-http-catedra.md) ---
# URL base que envió la cátedra (solo accesible por ZeroTier).
# Si queda vacía o falta, la aplicación no arranca.
CATEDRA_API_URL=
# JWT técnico de la cuenta del proyecto (vale un año; es el mismo en turnos-service).
# Nunca pegarlo en logs, issues ni PRs. Si se filtra, seguir la sección 5.4 del contrato.
# Si queda vacío o falta, la aplicación no arranca.
CATEDRA_JWT=
# Opcionales, con unidad (ms, s): conexión y respuesta completa (cuerpo incluido).
CATEDRA_CONNECT_TIMEOUT=5s
CATEDRA_READ_TIMEOUT=30s

# --- Kafka de la cátedra (ver docs/adr/0005-consumidor-kafka.md) ---
# Solo accesible por ZeroTier. Si alguna queda vacía o falta, la aplicación no arranca.
# Bootstrap y topic: kafkaBootstrapServers y kafkaCatalogTopic de integration (contrato §5.1).
CATEDRA_KAFKA_BOOTSTRAP_SERVERS=
CATEDRA_KAFKA_CATALOG_TOPIC=
# Un grupo por servicio: el kafkaConsumerGroupId de integration + "-catalogo" (turnos usa "-turnos").
# Compartir uno frena a turnos mientras el catálogo espera la exclusión o corre un snapshot.
CATEDRA_KAFKA_CONSUMER_GROUP=

# --- Redis de la cátedra, solo lectura (ver docs/adr/0006-cliente-redis.md) ---
# redisHost, redisPort, redisUsername y redisPassword de integration (contrato §14.1).
# Solo accesible por ZeroTier. Si alguna queda vacía o falta, la aplicación no arranca.
# Nunca pegar la contraseña en logs, issues ni PRs.
CATEDRA_REDIS_HOST=
CATEDRA_REDIS_PORT=
CATEDRA_REDIS_USERNAME=
CATEDRA_REDIS_PASSWORD=
# Opcionales, con unidad (ms, s): abrir la conexión y cada comando.
# Si se suben, hay que recalcular sync.lock.wait-timeout (ver SyncProperties).
CATEDRA_REDIS_CONNECT_TIMEOUT=5s
CATEDRA_REDIS_COMMAND_TIMEOUT=3s

# --- Sincronización (opcionales; ver docs/use-cases/README.md, DP-04) ---
# Comprobación periódica de versión contra Redis: recupera un aviso de Kafka perdido.
# Intervalo con unidad (s, m, h), contado desde que termina la pasada anterior; mínimo 1m.
# Es también el Retry-After del 503 con la base vacía.
# SYNC_PERIODIC_ENABLED=true
# SYNC_PERIODIC_INTERVAL=5m
